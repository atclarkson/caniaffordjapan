---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="Can I Afford Japan? — Real prices for an affordable Japan trip"
  description="A family's honest, photo-backed guide to what's actually free or cheap in Japan — temples, food, transit, and day trips, with real receipts."
>
  <section class="intro shell">
    <p class="kicker">A real, running answer to —</p>
    <h1>Can we actually afford this trip?</h1>
    <p class="lede">Honest, photo-backed posts on what things really cost in Japan — temples, food, transit, and day trips — from our own family's trips. No stock photos, no guessing.</p>
  </section>

  <section class="shell">
    <div class="post-grid">
      {posts.map((post) => (
        <a class="post-card" href={`/posts/${post.slug}/`}>
          <div class="post-card-image">
            <img src={post.data.heroImage} alt={post.data.heroAlt} loading="lazy" />
          </div>
          <div class="post-card-body">
            <p class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list">
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
