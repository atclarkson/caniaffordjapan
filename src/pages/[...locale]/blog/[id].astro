---
// src/pages/[...locale]/blog/[id].astro - la page d'article : en-tete, colonne de lecture avec sommaire, pied d'article, lectures suivantes, JSON-LD Article + BreadcrumbList.
//
// Une route par billet ET par langue. Les id de collection sont prefixes
// ("fr/mon-billet") parce que le contenu est range par langue ; l'URL, elle, ne
// porte que le slug, le prefixe etant deja dans le param locale. C'est ce qui
// permet au selecteur de langue d'emmener le lecteur sur LA traduction du
// billet qu'il lit, et pas sur l'accueil.
//
// Un brouillon se construit toujours, pour etre relu en local sur sa vraie
// page, mais part en noindex : il est deja hors des listes, du flux et de la
// recherche (src/js/posts.ts), il ne manquait que la consigne aux robots.
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PostBody from "@components/Sections/Post/PostBody.astro";
import PostFooter from "@components/Sections/Post/PostFooter.astro";
import PostHero from "@components/Sections/Post/PostHero.astro";
import ReadingProgress from "@components/Sections/Post/ReadingProgress.astro";
import RelatedPosts from "@components/Sections/Post/RelatedPosts.astro";
import TableOfContents from "@components/Sections/Post/TableOfContents.astro";
import { getSiteRoutes } from "@config/navData.json.ts";
import siteData from "@config/siteData.json";
import { defaultLocale, getLocale, localizePath, useTranslations } from "@i18n";
import { entryLocale, entrySlug } from "@i18n/content";
import { article, breadcrumbList, faqPage } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  // getCollection et non getResolvedPosts : les brouillons doivent AVOIR une
  // page, meme s'ils n'apparaissent nulle part ailleurs.
  const posts = await getCollection("posts");

  return Promise.all(
    posts.map(async (post) => {
      // Une reference cassee arrete le build avec le nom du fichier fautif,
      // plutot que de rendre une page a moitie vide en production.
      const author = await getEntry(post.data.author);
      if (!author) throw new Error(`Auteur inconnu "${post.data.author.id}" dans "${post.id}"`);
      const topic = await getEntry(post.data.topic);
      if (!topic) throw new Error(`Sujet inconnu "${post.data.topic.id}" dans "${post.id}"`);

      const locale = entryLocale(post.id);
      return {
        params: {
          // undefined genere la route sans prefixe : l'anglais est servi a la
          // racine, les autres langues sous leur code.
          locale: locale === defaultLocale ? undefined : locale,
          id: entrySlug(post.id),
        },
        props: { post, author, topic },
      };
    }),
  );
}

type Props = {
  post: CollectionEntry<"posts">;
  author: CollectionEntry<"authors">;
  topic: CollectionEntry<"topics">;
};

const { post, author, topic } = Astro.props;
const { Content, headings } = await render(post);

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

// Toutes les URLs passent par la table des routes, donc par localizePath : un
// blog servi sous /journal/ ne demande pas de rouvrir cette page.
const base = Astro.site ?? Astro.url;
const url = new URL(`${routes.posts}${entrySlug(post.id)}/`, base).href;

// La couverture sert de carte de partage quand elle existe ; sinon l'image par
// defaut du site. Les deux sont absolues, ce qu'exigent OG et schema.org.
const cover = post.data.cover;
// Share cards want 1200x630 (1.91:1). Most covers are portrait phone photos,
// which iMessage, Slack and Facebook crop unpredictably or shrink to a tiny
// thumbnail, so the card gets its own landscape crop of the cover.
// Sharp never upscales, so a cover narrower than 1200px gets a smaller crop
// at the same 1.91:1 shape, and the meta tags report its real size.
const shareWidth = cover ? Math.min(1200, cover.width) : 1200;
const shareHeight = Math.round(shareWidth / 1.905);
const shareImage = cover
  ? await getImage({
      src: cover,
      width: shareWidth,
      height: shareHeight,
      fit: "cover",
      format: "jpg",
      quality: 80,
    })
  : undefined;
const share = shareImage
  ? { src: shareImage.src, alt: post.data.coverAlt ?? post.data.title, width: shareWidth, height: shareHeight }
  : { ...siteData.defaultImage, width: 1200, height: 630 };
const topicUrl = new URL(`${routes.topics}${entrySlug(topic.id)}/`, base).href;
const publishedIso = post.data.pubDate.toISOString();
const modifiedIso = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const articleSchema = article({
  title: post.data.title,
  description: post.data.description,
  url,
  type: "BlogPosting",
  datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate ?? post.data.pubDate,
  image: cover ? [new URL(share.src, base).href, new URL(cover.src, base).href] : new URL(share.src, base).href,
  section: topic.data.name,
  keywords: post.data.tags,
  inLanguage: "en-US",
  authorSameAs: author.data.links?.map((link) => link.href),
  authorName: author.data.name,
  authorUrl: new URL(`${routes.authors}${entrySlug(author.id)}/`, base).href,
  publisherName: siteData.name,
  publisherUrl: new URL(localizePath("/", locale), base).href,
  publisherLogo: new URL("/apple-touch-icon.png", base).href,
});

const crumbSchema = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: topic.data.name, url: topicUrl },
  { name: post.data.title, url },
]);

// Seulement quand l'article porte reellement une section de questions-
// reponses visible (voir content.config.ts) : jamais de FAQPage sur un
// contenu que la page elle-meme ne montre pas.
const faqSchema = post.data.faq && post.data.faq.length > 0 ? faqPage(post.data.faq) : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  noindex={post.data.draft}
  image={share}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedIso} />
    <meta property="article:modified_time" content={modifiedIso} />
    <meta property="article:section" content={topic.data.name} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbSchema)} />
    {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <ReadingProgress />
  <Navbar />

  {/* tabindex="-1" : sans lui, le lien d'evitement deplace le defilement mais
      pas le focus sur certains navigateurs, et le clavier repart de la barre. */}
  <main id="content" tabindex="-1">
    {/* L'element article couvre l'en-tete, le corps ET le pied : c'est le
        billet entier, son titre compris. Les lectures suivantes restent
        dehors, elles appartiennent au site et pas au texte. */}
    <article>
      <PostHero {post} {author} {topic} />

      <PostBody>
        <TableOfContents slot="toc" {headings} />
        <Content />
      </PostBody>

      <PostFooter {post} {author} {url} />
    </article>

    <RelatedPosts {post} />
  </main>

  <Footer />
</BaseLayout>
