---
// src/pages/[...locale]/topics/[topic]/[...page].astro - l'archive d'un sujet, paginee par neuf.
//
// Une entree par langue ET par sujet. Le segment d'URL passe par entrySlug :
// l'id de collection vaut "en/typography", et l'ecrire tel quel donnerait
// /topics/en/typography/, une URL que personne n'a demandee.
import PostGrid from "@components/Sections/Archive/PostGrid.astro";
import TopicNav from "@components/Sections/Archive/TopicNav.astro";
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { defaultLocale, fmt, getLocale, localizePath, locales, useTranslations } from "@i18n";
import { entrySlug } from "@i18n/content";
import { getResolvedPosts, getSortedTopics } from "@js/posts";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";
import type { GetStaticPaths, Page } from "astro";
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { ResolvedPost } from "@js/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const groups = await Promise.all(
    locales.map(async (locale) => {
      const posts = await getResolvedPosts(locale);
      const topics = await getSortedTopics(locale);

      return topics.flatMap((topic) => {
        const slug = entrySlug(topic.id);
        const inTopic = posts.filter((entry) => entry.topicSlug === slug);
        return paginate(inTopic, {
          pageSize: 9,
          params: { locale: locale === defaultLocale ? undefined : locale, topic: slug },
          props: { topic, topics },
        });
      });
    }),
  );
  return groups.flat();
}) satisfies GetStaticPaths;

type Props = {
  page: Page<ResolvedPost>;
  topic: CollectionEntry<"topics">;
  topics: CollectionEntry<"topics">[];
};

const { page, topic, topics } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);

const slug = entrySlug(topic.id);
const heading = fmt(t.archive.topicTitle, { topic: topic.data.name });
const seoHeading = topic.data.seoTitle ?? heading;
const title =
  page.currentPage > 1
    ? `${seoHeading}, ${fmt(t.archive.pageSuffix, { n: page.currentPage })}`
    : seoHeading;
const description =
  page.currentPage > 1
    ? `${topic.data.description} Page ${page.currentPage} of ${page.lastPage}.`
    : topic.data.description;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.topics.metaTitle, url: new URL(localizePath("/topics/", locale), base).href },
  { name: topic.data.name, url: new URL(localizePath(`/topics/${slug}/`, locale), base).href },
]);

// Share card: a landscape crop of the newest cover on this page, so a shared
// topic link shows a real photo from that topic. No cover: the section card.
const leadCover = page.data.find((entry) => entry.post.data.cover)?.post.data;
let share: { src: string; alt: string; width: number; height: number } | undefined;
if (leadCover?.cover) {
  const width = Math.min(1200, leadCover.cover.width);
  const height = Math.round(width / 1.905);
  const img = await getImage({ src: leadCover.cover, width, height, fit: "cover", format: "jpg", quality: 80 });
  share = { src: img.src, alt: leadCover.coverAlt ?? topic.data.name, width, height };
}

// The posts listed on this page, as an ItemList inside a CollectionPage, so
// search engines read the topic page as a curated list of articles.
const pageUrl = new URL(Astro.url.pathname, base).href;
const collection = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: pageUrl,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: page.data.map((entry, i) => ({
      "@type": "ListItem",
      position: page.start + i + 1,
      url: new URL(localizePath(`/blog/${entry.slug}/`, locale), base).href,
      name: entry.post.data.title,
    })),
  },
};

// Pages 2+ stay indexable (self-canonical, own title). They used to be
// noindex, nofollow, which also told crawlers not to follow their links
// to older posts. Google's own guidance is to leave pagination indexable.
const noindex = false;
---

<BaseLayout {title} {description} {noindex} image={share}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collection)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      eyebrow={t.topics.eyebrow}
      title={heading}
      accentWord={topic.data.name}
      lede={topic.data.description}
      crumbs={[
        { label: t.topics.metaTitle, href: localizePath("/topics/", locale) },
        { label: topic.data.name },
      ]}
    >
      <TopicNav {topics} {locale} activeSlug={slug} class="mt-2" />
    </PageHero>

    <PostGrid
      posts={page.data}
      {locale}
      basePath={localizePath(`/topics/${slug}`, locale)}
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      total={page.total}
      headingLevel="h2"
      emptyTitle={t.topics.emptyTitle}
      emptyDescription={t.topics.emptyLede}
      emptyCtaLabel={t.archive.emptyCta}
      emptyCtaHref={localizePath("/blog/", locale)}
    />
  </main>

  <Footer />
</BaseLayout>
