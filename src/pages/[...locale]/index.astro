---
// src/pages/[...locale]/index.astro - l'accueil editorial : ouverture, billet a la une, notes recentes, sujets, signatures, mot du studio et invitation a s'abonner.
//
// L'accueil d'un blog n'est pas une page commerciale : il n'y a ni preuve sociale,
// ni tarifs, ni bandeau de logos. Un lecteur arrive pour savoir s'il y a quelque
// chose a lire, et la reponse doit tenir dans le premier ecran et demi.
//
// Toutes les listes sont calculees ICI, une seule fois. Les sections recoivent
// des tableaux deja tries : aucune d'elles ne relit une collection, donc rien ne
// peut trier differemment d'une section a l'autre.
import { rotationForMonth } from "@data/featuredRotation";
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import BeforeYouBook from "@components/Sections/Home/BeforeYouBook.astro";
import BrowseTopics from "@components/Sections/Home/BrowseTopics.astro";
import Destinations from "@components/Sections/Home/Destinations.astro";
import Hero from "@components/Sections/Home/Hero.astro";
import MeetFamily from "@components/Sections/Home/MeetFamily.astro";
import Partners from "@components/Sections/Home/Partners.astro";
import StartPlanning from "@components/Sections/Home/StartPlanning.astro";
import WhatWeSpent from "@components/Sections/Home/WhatWeSpent.astro";
import WorthTheMoney from "@components/Sections/Home/WorthTheMoney.astro";
import LatestPosts from "@components/Sections/Home/LatestPosts.astro";
import siteData from "@config/siteData.json";
import { getLocale, localePaths, localizePath, useTranslations } from "@i18n";
import { getResolvedPosts, getSortedTopics } from "@js/posts";
import { organization, website } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";

// Une seule page source, une sortie par langue : / et /fr/.
export const getStaticPaths = localePaths;

const locale = getLocale(Astro);
const t = useTranslations(locale);

const posts = await getResolvedPosts(locale);

// "Before you book" rotates monthly through a fixed list of posts we
// want to rank and earn from (src/data/featuredRotation.ts). Falls back to
// the newest post if none of them is published.
const featured =
  rotationForMonth()
    .map((slug) => posts.find((entry) => entry.slug === slug))
    .find((entry) => entry !== undefined) ?? posts.at(0);
const latest = posts.filter((entry) => entry !== featured).slice(0, 6);

const topics = await getSortedTopics(locale);

// Posts per topic, counted once here and passed to the sections that show counts.
const topicCounts: Record<string, number> = {};
for (const entry of posts) {
  topicCounts[entry.topicSlug] = (topicCounts[entry.topicSlug] ?? 0) + 1;
}

const title = t.home.metaTitle;
const description = t.home.metaDescription;

const base = Astro.site ?? Astro.url;
const siteUrl = new URL(localizePath("/", locale), base).href;
const schemas = [
  organization({
    name: siteData.name,
    url: siteUrl,
    sameAs: siteData.author.twitter ? [`https://x.com/${siteData.author.twitter}`] : undefined,
  }),
  website({ name: siteData.name, url: siteUrl, description }),
];
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    {
      schemas.map((node) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }
  </Fragment>

  <Navbar />

  <main id="content">
    <Hero postCount={posts.length} {topics} counts={topicCounts} />
    {/* Rebuilt 2026-11-12 from the owner's brief: planning first, archive
        second. Order: before you book, start planning, what we spent,
        destinations, worth the money, latest posts, the family, all
        topics, partners. */}
    {featured && <BeforeYouBook entry={featured} />}
    <StartPlanning />
    <WhatWeSpent />
    <Destinations counts={topicCounts} />
    <WorthTheMoney {posts} />
    {latest.length > 0 && <LatestPosts posts={latest} />}
    <MeetFamily />
    <BrowseTopics {topics} counts={topicCounts} />
    <Partners />
  </main>

  {/* NewsletterInvite removed for now, no signup provider wired up (see
      Footer.astro's `newsletter` prop, defaults to false site-wide). */}
  <Footer />
</BaseLayout>
