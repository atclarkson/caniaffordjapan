---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage: string;
  heroAlt: string;
  tags: string[];
}

const { title, description, pubDate, heroImage, heroAlt, tags } = Astro.props;
const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${title} | Can I Afford Japan?`} description={description} image={heroImage}>
  <article class="post shell">
    <div class="post-head">
      <p class="meta">{dateStr}{tags.length > 0 && <> · {tags.join(', ')}</>}</p>
      <h1>{title}</h1>
    </div>
    <img class="post-hero" src={heroImage} alt={heroAlt} loading="eager" />
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
