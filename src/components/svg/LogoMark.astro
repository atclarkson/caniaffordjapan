---
// src/components/svg/LogoMark.astro - the site's mark: a cream yen sign on a red disc, the same drawing as the favicon.
//
// Replaced the turquoise wave in the header and footer on 2026-11-10 (the site
// owner asked for a yen mark instead of squiggles). The paths are copied from
// scripts/favicon.mjs so the tab icon and the on-page logo match exactly.
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="8 8 48 48"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path
    d="M32 8.5C44.8 8.8 54.6 18.1 55.3 30.8c.8 13.1-8.8 23.6-21.9 24.7-13.5 1.1-24.2-8-24.7-21.5C8.2 20.2 18.2 8.2 32 8.5Z"
    class="fill-mark-ink"></path>
  <path
    d="m18.5 19.5 4.7-3.8L32 27.4l8.8-11.7 4.7 3.8-10.4 13.2v1.7h8v5.2h-8v3h8v5.2h-8v7.3h-6.2v-7.3h-8v-5.2h8v-3h-8v-5.2h8v-1.7L18.5 19.5Z"
    class="fill-mark-ground"></path>
</svg>
