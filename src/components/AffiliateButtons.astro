---
import { affiliates, type Provider } from '../data/affiliates';

interface Props {
  heading: string;
  query: string;
  providers?: Provider[];
}

const { heading, query, providers = ['klook', 'getyourguide', 'expedia'] } = Astro.props;
const anyPending = providers.some((p) => affiliates[p].pending);
---
<div class="affiliate-box">
  <h3>{heading}</h3>
  {anyPending && (
    <p class="note">Links below go straight to the provider — not affiliate links yet. We'll mark it clearly here once our partnerships are live (see our <a href="/disclosure">disclosure page</a>).</p>
  )}
  <div class="affiliate-buttons">
    {providers.map((p) => (
      <a href={affiliates[p].searchUrl(query)} target="_blank" rel="noopener">
        Search on {affiliates[p].label}
      </a>
    ))}
  </div>
</div>
