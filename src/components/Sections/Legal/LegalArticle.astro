---
// src/components/Sections/Legal/LegalArticle.astro - the body of the one legal page: a date line, then short plain-English sections.
//
// Simplified 2026-11-10 when privacy, terms and the legal notice merged into
// one short page: no table of contents and no "back to top" under every
// section, since the whole page reads in a minute. A section's body can be
// one paragraph or several.
import { formatDate, fmt, type Locale } from "@i18n";
import { slugify } from "@js/textUtils";

type Section = { title: string; body: string | readonly string[] };

type Props = {
  sections: readonly Section[];
  /** ISO date (YYYY-MM-DD) of the last revision. */
  updated: string;
  /** The date line's template, with its {date} token. */
  updatedTemplate: string;
  locale: Locale;
  class?: string;
};

const { sections, updated, updatedTemplate, locale, class: className } = Astro.props;

const anchored = sections.map((section) => ({
  ...section,
  id: slugify(section.title),
  paragraphs: typeof section.body === "string" ? [section.body] : section.body,
}));
---

<div class:list={["container-page py-12 md:py-16", className]} data-slot="legal-article">
  <div class="prose">
    <p class="text-muted-foreground font-sans text-sm">
      <time datetime={updated}>{fmt(updatedTemplate, { date: formatDate(new Date(updated), locale) })}</time>
    </p>
    {
      anchored.map((section) => (
        <section aria-labelledby={section.id}>
          <h2 id={section.id}>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }
  </div>
</div>
