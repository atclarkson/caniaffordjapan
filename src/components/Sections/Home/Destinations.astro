---
// src/components/Sections/Home/Destinations.astro - four cities as big photo cards, linking to their topic pages.
//
// Tokyo and Osaka are AL_Vault family photos, Kyoto the Nintendo Museum
// post's cover. Hiroshima is an Unsplash photo of the A-Bomb Dome supplied
// by the owner (Unsplash licence: free to use, no attribution required);
// AL_Vault holds the family's Hiroshima trip as video only.
import tokyo from "../../../assets/home/tokyo-skytree.jpg";
import osaka from "../../../assets/home/osaka-tsutenkaku.jpg";
import kyoto from "../../../assets/covers/nintendo-museum-uji-ticket-price-lottery.jpg";
import hiroshima from "../../../assets/home/hiroshima-dome.jpg";
import { getSiteRoutes } from "@config/navData.json.ts";
import { getLocale } from "@i18n";
import { Image } from "astro:assets";

type Props = { counts: Record<string, number> };
const { counts } = Astro.props;
const routes = getSiteRoutes(getLocale(Astro));

const cities = [
  { slug: "tokyo", name: "Tokyo", src: tokyo, focus: "object-[50%_35%]", alt: "The family selfie under Tokyo Skytree with cherry blossoms behind." },
  { slug: "osaka", name: "Osaka", src: osaka, focus: "object-[50%_40%]", alt: "Adam, Lily and Cora in front of Tsutenkaku tower in Shinsekai, Osaka." },
  { slug: "kyoto", name: "Kyoto", src: kyoto, focus: "object-[50%_40%]", alt: "The family holding entry cards at the Nintendo Museum in Uji, Kyoto." },
  { slug: "hiroshima", name: "Hiroshima", src: hiroshima, focus: "object-[50%_50%]", alt: "The A-Bomb Dome in Hiroshima Peace Memorial Park in late afternoon light." },
];
---

<section class="container-page py-16 md:py-20" aria-labelledby="dest-title" data-slot="destinations">
  <h2 id="dest-title" class="font-display text-display-sm md:text-display-md text-foreground">Explore by destination</h2>
  <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
    {
      cities.map((city) => (
        <li>
          <a
            href={`${routes.topics}${city.slug}/`}
            class="group block transition-transform duration-300 hover:-translate-y-0.5 motion-reduce:transition-none"
          >
            <Image
              src={city.src}
              alt={city.alt}
              widths={[360, 600]}
              sizes="(min-width: 1024px) 22vw, 46vw"
              class:list={[
                "rounded-card aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100",
                city.focus,
              ]}
              loading="lazy"
              decoding="async"
            />
            <span class="mt-3 flex items-baseline justify-between gap-3">
              <span class="font-display text-foreground text-xl font-semibold sm:text-2xl">{city.name}</span>
              <span class="text-muted-foreground text-sm">{counts[city.slug] ?? 0} posts</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
