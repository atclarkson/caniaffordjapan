---
// src/components/Sections/Home/Hero.astro - the home page's first screen.
//
// Rebuilt 2026-11-10 after the site owner rejected the old one (eyebrow,
// squiggle-underlined question headline, stats row, two buttons). What a
// first screen has to do, from the research behind this version: say what
// the site is and who it's for in about five seconds, in a plain headline
// of under ten words, with one supporting line that carries a hard fact,
// and one obvious next step. On a site with 150+ posts that step is search
// (the pattern Klook and Airbnb lead with), backed by links into the
// biggest topics for people who'd rather browse.
//
// No eyebrow, no decorative underline, no question as a headline, no stats
// strip: those are template tells.
//
// The picture is US (2026-11-10, the site owner's own mockup): a loose
// stack of five real family snapshots from AL_Vault on the right, words and
// search on the left over the plain page ground. Every photo is ours and
// shows all or part of the family in Japan; swap them by replacing the files
// in src/assets/hero/ and the alt text below. Each tilts a few degrees and
// straightens with a small lift on hover (rests under reduced motion).
import usjGlobe from "../../../assets/hero/usj-globe.jpg";
import yakiniku from "../../../assets/hero/yakiniku.jpg";
import glico from "../../../assets/hero/glico.jpg";
import blossoms from "../../../assets/hero/blossoms.jpg";
import disney from "../../../assets/hero/disney.jpg";
import { Icon } from "@components/svg/icons";
import { getSiteRoutes } from "@config/navData.json.ts";
import { fmt, getLocale, useTranslations } from "@i18n";
import { entrySlug } from "@i18n/content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  /** Number of published posts, for the sub-line and the search placeholder. */
  postCount: number;
  topics: CollectionEntry<"topics">[];
  /** Published posts per topic slug. */
  counts: Record<string, number>;
}

const { postCount, topics, counts } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

// The five topics with the most posts, biggest first (labelled "Top topics",
// not "Popular": this is post count, not traffic).
const popular = topics
  .map((topic) => ({ topic, slug: entrySlug(topic.id), n: counts[entrySlug(topic.id)] ?? 0 }))
  .filter((item) => item.n > 0)
  .sort((a, b) => b.n - a.n || a.topic.data.name.localeCompare(b.topic.data.name))
  .slice(0, 5);

// The five snapshots, back to front. `place` positions each inside the
// collage box (percentages, so it scales at every width); `focus` keeps the
// faces in frame when a portrait photo is cropped to 4:3.
const snaps = [
  {
    src: yakiniku,
    alt: "The five of us at a yakiniku table in Osaka, two big beers in front and an A5 Kobe beef poster on the wall.",
    place: "left-[0%] top-[1%] w-[50%] -rotate-[4deg]",
    focus: "object-[50%_88%]",
  },
  {
    src: glico,
    alt: "Family selfie at night in front of the lit-up Glico Man sign on Dotonbori, Osaka.",
    place: "right-[0%] top-[0%] w-[46%] rotate-[3deg]",
    focus: "object-[50%_14%]",
  },
  {
    src: usjGlobe,
    alt: "All five of us in front of the Universal Studios Japan globe on Cora's ninth birthday.",
    place: "left-[12%] top-[29%] w-[76%] -rotate-[1.5deg] z-10",
    focus: "object-center",
  },
  {
    src: blossoms,
    alt: "Lily, Cora and Harper in matching sundresses under a cherry tree in full bloom at Ogimachi Park, Osaka.",
    place: "left-[1%] bottom-[0%] w-[44%] rotate-[3deg] z-20",
    focus: "object-[50%_62%]",
  },
  {
    src: disney,
    alt: "The family holding up Mickey-shaped ice cream bars at Tokyo Disneyland after dark.",
    place: "right-[1%] bottom-[2%] w-[46%] -rotate-[3deg] z-20",
    focus: "object-[50%_62%]",
  },
];
---

<section
  class="container-page relative pt-28 pb-14 sm:pt-32 md:pt-36 md:pb-20 lg:pb-24"
  aria-labelledby="hero-title"
  data-slot="home-hero"
>
  <div
    class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.08fr)] lg:gap-14 xl:gap-20"
  >
    <div class="flex min-w-0 flex-col">
      <h1 id="hero-title" class="font-display text-display-md lg:text-display-lg text-foreground">
        {t.home.heroTitle}
      </h1>

      <p class="text-muted-foreground mt-5 max-w-[34rem] text-lg leading-relaxed md:text-xl">
        {fmt(t.home.heroLede, { n: postCount })}
      </p>

      {/* A plain GET form: works with no JavaScript, and /search/?q=
          already arrives filtered (Search.astro reads the q param). */}
      <form action={routes.search} method="get" role="search" class="mt-8 w-full max-w-[36rem]" data-hero-search>
        <label for="hero-search" class="sr-only">{fmt(t.home.heroSearchLabel, { n: postCount })}</label>
        <div
          class="rounded-pill border-border bg-card flex items-center gap-2 border p-1.5 pl-5 shadow-sm transition-shadow duration-150 focus-within:border-[var(--color-primary)] focus-within:shadow-md"
        >
          <span class="text-muted-foreground shrink-0" aria-hidden="true">
            <Icon name="search" size={20} />
          </span>
          <input
            id="hero-search"
            name="q"
            type="search"
            autocomplete="off"
            enterkeyhint="search"
            placeholder={t.home.heroSearchPlaceholder}
            class="text-foreground placeholder:text-muted-foreground min-w-0 flex-1 bg-transparent py-2.5 text-base focus:outline-none md:text-lg"
          />
          <button
            type="submit"
            class="bg-primary text-primary-foreground rounded-pill shrink-0 px-5 py-2.5 font-sans text-base font-semibold transition-[transform,filter] duration-150 hover:brightness-110 active:scale-[0.97] motion-reduce:transition-none"
          >
            {t.home.heroSearchButton}
          </button>
        </div>
      </form>

      {
        popular.length > 0 && (
          <nav aria-label={t.home.heroPopularLabel} class="mt-6 max-w-[36rem]">
            <ul class="flex flex-wrap items-center gap-2.5">
              {popular.map(({ topic, slug }) => (
                <li>
                  <a
                    href={`${routes.topics}${slug}/`}
                    class="rounded-pill border-border text-foreground hover:border-foreground/40 hover:bg-muted inline-flex min-h-10 items-center border px-4 text-sm font-medium transition-colors duration-150"
                  >
                    {topic.data.name}
                  </a>
                </li>
              ))}
              <li>
                <a
                  href={routes.posts}
                  class="text-primary inline-flex min-h-10 items-center gap-1 px-2 text-sm font-semibold underline-offset-4 hover:underline"
                >
                  {t.home.heroAllPosts}
                  <Icon name="arrow-right" size={16} />
                </a>
              </li>
            </ul>
          </nav>
        )
      }
    </div>

    {/* The collage. A fixed-ratio box so the stack keeps its shape at every
        width; on a phone it sits under the search, a little smaller. */}
    <div class="relative mx-auto aspect-[1/1.08] w-full max-w-[34rem] lg:max-w-none" data-hero-collage>
      {
        snaps.map((snap, i) => (
          <figure
            class:list={[
              "hero-snap absolute rounded-md bg-white p-1.5 shadow-[0_10px_30px_-8px_rgb(0_0_0/0.35)] sm:p-2",
              snap.place,
            ]}
          >
            <Image
              src={snap.src}
              alt={snap.alt}
              widths={i === 2 ? [480, 760, 1000] : [320, 480, 640]}
              sizes={i === 2 ? "(min-width: 1024px) 40vw, 80vw" : "(min-width: 1024px) 24vw, 46vw"}
              loading="eager"
              fetchpriority={i === 2 ? "high" : "auto"}
              decoding="async"
              class:list={["aspect-[4/3] w-full rounded-[3px] object-cover", snap.focus]}
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Hover: the snapshot straightens and lifts above its neighbours. The
   * resting tilt comes from the rotate utility; `rotate: 0deg` overrides
   * it, so no transform math is duplicated here. */
  .hero-snap {
    transition:
      rotate 300ms ease,
      translate 300ms ease,
      box-shadow 300ms ease;
  }
  .hero-snap:hover {
    rotate: 0deg;
    translate: 0 -4px;
    z-index: 30;
    box-shadow: 0 18px 40px -10px rgb(0 0 0 / 0.4);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-snap {
      transition: none;
    }
    .hero-snap:hover {
      translate: none;
    }
  }
</style>
