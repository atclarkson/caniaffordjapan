---
// src/components/Sections/Home/Hero.astro - the home page's first screen.
//
// Rebuilt 2026-11-10 after the site owner rejected the old one (eyebrow,
// squiggle-underlined question headline, stats row, two buttons). What a
// first screen has to do, from the research behind this version: say what
// the site is and who it's for in about five seconds, in a plain headline
// of under ten words, with one supporting line that carries a hard fact,
// and one obvious next step. On a site with 150+ posts that step is search
// (the pattern Klook and Airbnb lead with), backed by links into the
// biggest topics for people who'd rather browse.
//
// No eyebrow, no decorative underline, no question as a headline, no stats
// strip: those are template tells. The photograph stays; on desktop the
// words, search and topic links sit centred (the owner found the left-hand
// column cramped, with the topic links wrapping for no reason).
//
// TWO PHOTOS, ONE PER THEME: cherry blossoms in front of the Skytree for
// light (the default theme, so it loads eager and high priority), Senso-ji
// at night for dark (lazy, hidden until html.dark is set).
import heroDay from "../../../assets/home-hero-day.jpg";
import heroNight from "../../../assets/home-hero-night.jpg";
import { Icon } from "@components/svg/icons";
import { getSiteRoutes } from "@config/navData.json.ts";
import { fmt, getLocale, useTranslations } from "@i18n";
import { entrySlug } from "@i18n/content";
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";

interface Props {
  /** Number of published posts, for the sub-line and the search placeholder. */
  postCount: number;
  topics: CollectionEntry<"topics">[];
  /** Published posts per topic slug. */
  counts: Record<string, number>;
}

const { postCount, topics, counts } = Astro.props;

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);

// The five topics with the most posts, biggest first (labelled "Top topics",
// not "Popular": this is post count, not traffic).
const popular = topics
  .map((topic) => ({ topic, slug: entrySlug(topic.id), n: counts[entrySlug(topic.id)] ?? 0 }))
  .filter((item) => item.n > 0)
  .sort((a, b) => b.n - a.n || a.topic.data.name.localeCompare(b.topic.data.name))
  .slice(0, 5);
---

<div class="bg-background p-2 sm:p-3 md:p-4" data-slot="home-hero">
  <section
    class="deep-scene rounded-panel relative isolate overflow-hidden"
    aria-labelledby="hero-title"
    data-deep-scene
  >
    <Picture
      src={heroDay}
      formats={["avif"]}
      fallbackFormat="webp"
      alt=""
      widths={[720, 800, 1200, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-photo-day pointer-events-none absolute inset-0 size-full object-cover object-[center_62%]"
      aria-hidden="true"
    />
    <Picture
      src={heroNight}
      formats={["avif"]}
      fallbackFormat="webp"
      alt=""
      widths={[720, 800, 1200, 1920, 2560]}
      sizes="100vw"
      loading="lazy"
      class="hero-photo-night pointer-events-none absolute inset-0 size-full object-cover object-[center_62%]"
      aria-hidden="true"
    />
    <div class="hero-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div
      class="container-page relative z-10 flex min-h-[82svh] flex-col justify-center pt-28 pb-12 sm:pt-32 md:pt-36 md:pb-16"
    >
      <div class="mx-auto flex w-full max-w-[52rem] min-w-0 flex-col lg:items-center lg:text-center">
        <h1 id="hero-title" class="font-display text-display-md lg:text-display-xl text-white [text-shadow:0_2px_24px_rgb(0_0_0/0.45)]">
          {t.home.heroTitle}
        </h1>

        <p class="mt-5 max-w-[40rem] text-lg leading-relaxed text-white/90 [text-shadow:0_1px_12px_rgb(0_0_0/0.6)] md:text-xl">
          {fmt(t.home.heroLede, { n: postCount })}
        </p>

        {/* A plain GET form: works with no JavaScript, and /search/?q=
            already arrives filtered (Search.astro reads the q param). */}
        <form action={routes.search} method="get" role="search" class="mt-8 w-full max-w-[44rem]" data-hero-search>
          <label for="hero-search" class="sr-only">{fmt(t.home.heroSearchLabel, { n: postCount })}</label>
          <div
            class="rounded-pill flex items-center gap-2 bg-white p-1.5 pl-5 shadow-lg ring-1 ring-black/5 focus-within:ring-2 focus-within:ring-[var(--color-primary)]"
          >
            <span class="shrink-0 text-neutral-500" aria-hidden="true">
              <Icon name="search" size={20} />
            </span>
            <input
              id="hero-search"
              name="q"
              type="search"
              autocomplete="off"
              enterkeyhint="search"
              placeholder={t.home.heroSearchPlaceholder}
              class="min-w-0 flex-1 bg-transparent py-2.5 text-base text-neutral-900 placeholder:text-neutral-500 focus:outline-none md:text-lg"
            />
            <button
              type="submit"
              class="bg-primary text-primary-foreground rounded-pill shrink-0 px-5 py-2.5 font-sans text-base font-semibold transition-[transform,filter] duration-150 hover:brightness-110 active:scale-[0.97] motion-reduce:transition-none"
            >
              {t.home.heroSearchButton}
            </button>
          </div>
        </form>

        {
          popular.length > 0 && (
            <nav aria-label={t.home.heroPopularLabel} class="mt-6">
              <p class="flex flex-wrap items-center gap-2 text-sm text-white/90 [text-shadow:0_1px_8px_rgb(0_0_0/0.6)] lg:justify-center">
                <span class="mr-1 font-medium">{t.home.heroPopularLabel}:</span>
                {popular.map(({ topic, slug }) => (
                  <a
                    href={`${routes.topics}${slug}/`}
                    class="rounded-pill inline-flex min-h-9 items-center border border-white/30 bg-white/10 px-3.5 font-medium text-white backdrop-blur-sm transition-colors duration-150 hover:border-white/70 hover:bg-white/20"
                  >
                    {topic.data.name}
                  </a>
                ))}
                <a
                  href={routes.posts}
                  class="inline-flex min-h-9 items-center gap-1 px-2 font-medium text-white underline-offset-4 hover:underline"
                >
                  {t.home.heroAllPosts}
                  <Icon name="arrow-right" size={16} />
                </a>
              </p>
            </nav>
          )
        }
      </div>
    </div>
  </section>
</div>

<style>
  /* Only one of the two photos shows at a time. .dark lives on <html>. */
  .hero-photo-night {
    display: none;
  }
  :global(html.dark) .hero-photo-day {
    display: none;
  }
  :global(html.dark) .hero-photo-night {
    display: block;
  }

  /* Desktop: the words sit centred (a search-first hero, like Klook's), so
   * the veil is an even wash, a little denser behind the middle, with the
   * blossoms still showing at the edges. */
  .hero-veil {
    background:
      radial-gradient(ellipse 60% 55% at 50% 50%, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0) 100%),
      linear-gradient(180deg, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0.42) 50%, rgb(0 0 0 / 0.55) 100%);
  }

  /* Below 1024px the words run the full width, so the veil turns vertical
   * and stays dense enough under every line. */
  @media (max-width: 63.99rem) {
    .hero-veil {
      background: linear-gradient(
        180deg,
        rgb(0 0 0 / 0.55) 0%,
        rgb(0 0 0 / 0.72) 45%,
        rgb(0 0 0 / 0.6) 100%
      );
    }
  }
</style>
