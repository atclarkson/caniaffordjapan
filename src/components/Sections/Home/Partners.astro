---
// src/components/Sections/Home/Partners.astro - "Brands we work with": the real partners' real logos, in one quiet row.
//
// Each logo links through that partner's real affiliate link
// (src/data/homePage.ts PARTNERS); the disclosure line sits under the row.
// No cards: the logos sit straight on the page ground, a little muted until
// hovered. In dark mode they render as white marks so dark type stays legible.
import { PARTNERS } from "@data/homePage";
---

<section class="container-page py-14 md:py-16" aria-labelledby="partners-title" data-slot="partners">
  <h2 id="partners-title" class="font-display text-display-sm text-foreground">Brands we work with</h2>
  <ul class="mt-8 grid grid-cols-2 items-center justify-items-center gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
    {
      PARTNERS.map((partner) => (
        <li>
          <a
            href={partner.href}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="block opacity-80 transition-[opacity,transform] duration-200 hover:-translate-y-0.5 hover:opacity-100 motion-reduce:transition-none"
          >
            <img
              src={partner.logo}
              alt={partner.name}
              width={partner.w}
              height={partner.h}
              style={`height:${partner.height}px;width:auto`}
              class="dark:brightness-0 dark:invert"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="text-muted-foreground mt-8 text-sm">
    These are affiliate partners: if you book through our links we may earn a commission, at no extra cost to you.{" "}
    <a href="/legal/" class="hover:text-foreground underline underline-offset-2">How this works</a>
  </p>
</section>
