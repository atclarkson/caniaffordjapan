---
// src/components/Sections/Home/Partners.astro - "Brands we work with": the real partners' real logos, in one quiet row.
//
// Each logo links through that partner's real affiliate link
// (src/data/homePage.ts PARTNERS). No disclosure line here: the site's
// /legal/ page and each post cover it, not every mention of a partner.
// No cards: the logos sit straight on the page ground, a little muted until
// hovered. A blanket dark:invert on every logo looked worse than the
// original colors (flattened detail, ghosting), so only the three partners
// whose normal logo is actually illegible on dark (Expedia, Hotels.com,
// Airalo) get a real `logoDark` file, swapped in the same dark:hidden /
// hidden dark:block way the header and footer logos already do. The rest
// render once, unmodified, their real colors already read fine on dark.
import { PARTNERS } from "@data/homePage";
---

<section class="container-page py-16 md:py-20" aria-labelledby="partners-title" data-slot="partners">
  <h2 id="partners-title" class="font-display text-display-sm text-foreground">Brands we work with</h2>
  <ul class="mt-8 grid grid-cols-2 items-center justify-items-center gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
    {
      PARTNERS.map((partner) => (
        <li>
          <a
            href={partner.href}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="block opacity-80 transition-[opacity,transform] duration-200 hover:-translate-y-0.5 hover:opacity-100 motion-reduce:transition-none"
          >
            {"logoDark" in partner ? (
              <>
                <img
                  src={partner.logo}
                  alt={partner.name}
                  width={partner.w}
                  height={partner.h}
                  style={`height:${partner.height}px;width:auto`}
                  class="dark:hidden"
                  data-no-dim
                  loading="lazy"
                  decoding="async"
                />
                <img
                  src={partner.logoDark}
                  alt={partner.name}
                  width={partner.w}
                  height={partner.h}
                  style={`height:${partner.height}px;width:auto`}
                  class="hidden dark:block"
                  data-no-dim
                  loading="lazy"
                  decoding="async"
                />
              </>
            ) : (
              <img
                src={partner.logo}
                alt={partner.name}
                width={partner.w}
                height={partner.h}
                style={`height:${partner.height}px;width:auto`}
                data-no-dim
                loading="lazy"
                decoding="async"
              />
            )}
          </a>
        </li>
      ))
    }
  </ul>
</section>
