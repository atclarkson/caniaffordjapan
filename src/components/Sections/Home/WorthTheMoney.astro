---
// src/components/Sections/Home/WorthTheMoney.astro - six verdict posts as short cards: the post, and its one-line answer.
import { Icon } from "@components/svg/icons";
import { getSiteRoutes } from "@config/navData.json.ts";
import { WORTH_IT } from "@data/homePage";
import { getLocale } from "@i18n";
import type { ResolvedPost } from "@js/posts";
import { Image } from "astro:assets";

type Props = { posts: ResolvedPost[] };
const { posts } = Astro.props;
const routes = getSiteRoutes(getLocale(Astro));

// Only verdicts whose post is published; a removed post just drops out.
const items = WORTH_IT.flatMap((item) => {
  const entry = posts.find((p) => p.slug === item.slug);
  return entry ? [{ ...item, entry }] : [];
});
---

<section class="bg-surface border-border border-y" aria-labelledby="worth-title" data-slot="worth-the-money">
  <div class="container-page py-16 md:py-20">
    <h2 id="worth-title" class="font-display text-display-sm md:text-display-md text-foreground">Worth the money?</h2>
    <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        items.map(({ entry, verdict }) => (
          <li class="flex">
            <a
              href={`${routes.posts}${entry.slug}/`}
              class="group bg-card border-border rounded-card flex w-full gap-4 border p-4 transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-float motion-reduce:transition-none"
            >
              {entry.post.data.cover && (
                <span class="block aspect-[4/3] w-24 shrink-0 self-start overflow-hidden rounded-lg sm:w-28">
                  <Image
                    src={entry.post.data.cover}
                    alt=""
                    widths={[120, 200]}
                    sizes="6rem"
                    class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
              <span class="flex min-w-0 flex-col gap-1.5">
                <span class="font-display text-foreground leading-snug font-semibold text-balance">{entry.post.data.title}</span>
                <span class="text-muted-foreground text-sm leading-relaxed">{verdict}</span>
                <span class="text-primary mt-auto flex items-center gap-1 text-sm font-semibold" aria-hidden="true">
                  See the numbers <Icon name="arrow-right" size={14} />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
