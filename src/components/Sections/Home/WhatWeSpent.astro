---
// src/components/Sections/Home/WhatWeSpent.astro - one real day of family spending, as clean numbers, from a real post.
//
// Every figure comes from src/data/homePage.ts (WHAT_WE_SPENT), copied from
// the post's own table. The receipt itself (torn top and bottom edges) is
// the shared Post/Receipt.astro component, pulled out 2026-11-16 once
// "daily costs" became a real recurring post type (folded into Throwback
// Thursday) rather than a one-off home page graphic. Niko and her
// calculator look up at it from under the photo.
import uenoPagoda from "../../../assets/home/ueno-pagoda.jpg";
import Receipt from "@components/Post/Receipt.astro";
import { WHAT_WE_SPENT as day } from "@data/homePage";
import { Image } from "astro:assets";
import nikoCalc from "../../../assets/niko/niko-calculator.png";
---

<section class="bg-surface border-border border-y" aria-labelledby="spent-title" data-slot="what-we-spent">
  <div class="container-page py-16 md:py-20">
    <h2 id="spent-title" class="font-display text-display-sm md:text-display-md text-foreground">What we spent</h2>
    <p class="text-muted-foreground mt-3 max-w-[40rem] text-lg">Days from our own budget tracking, receipts and all.</p>

    <div class="mt-10 grid items-start gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-x-14 lg:gap-y-4">
      <figure class="mx-auto w-full min-w-0 max-w-[34rem] -rotate-[1.5deg] lg:col-start-1 lg:row-start-1 rounded-md bg-white p-2 shadow-[0_10px_30px_-8px_rgb(0_0_0/0.35)]">
        <Image
          quality={70}
          src={uenoPagoda}
          alt="The family at the five-story pagoda in Ueno Park on a clear autumn day."
          widths={[480, 800]}
          sizes="(min-width: 1024px) 34rem, 92vw"
          class="aspect-[4/3] w-full rounded-[3px] object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <Receipt
          heading={day.heading}
          subheading="Family of five"
          groups={day.groups}
          total={day.total}
          totalLabel={day.totalLabel}
          readMoreHref={`/blog/${day.slug}/`}
        />
        <p class="mt-5 text-center">
          <a
            href="/topics/daily-costs/"
            class="text-muted-foreground inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold underline-offset-4 hover:underline"
          >
            See every day we've tracked
          </a>
        </p>
      </div>

      <Image
        quality={80}
        src={nikoCalc}
        alt=""
        widths={[320, 640]}
        sizes="(min-width: 1024px) 20rem, 16rem"
        class="order-3 mr-auto ml-[8%] w-56 sm:w-64 lg:order-none lg:col-start-1 lg:row-start-2 lg:mr-0 lg:ml-auto lg:w-80"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
