---
// src/components/Sections/Home/MeetFamily.astro - who runs the site, and where to follow along.
//
// Rebuilt 2026-11-15 from the owner's mockup: a family photo beside a short
// intro and "Read our story", then "Come along for the trip." with the three
// social channels in one card that Niko peeks over, and a link to the Adam
// and Linds site. Links come from the author file; the brand marks are
// Simple Icons paths (CC0) in each brand's colour.
import familyPhoto from "../../../assets/home/family-dotonbori.jpg";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { getSiteRoutes } from "@config/navData.json.ts";
import author from "@data/authors/en/the-clarksons.json";
import { getLocale } from "@i18n";
import { Image } from "astro:assets";
import { SOCIAL_PATHS as PATHS } from "@data/socialIcons";


const routes = getSiteRoutes(getLocale(Astro));
const link = (label: string) => author.links.find((l) => l.label === label)?.href ?? "";

const channels = [
  { name: "YouTube", line: "Watch our trips", href: link("YouTube"), color: "var(--color-brand-youtube)", tint: "var(--color-brand-youtube)", path: PATHS.youtube },
  { name: "Instagram", line: "The moments in between", href: link("Instagram"), color: "var(--color-brand-instagram)", tint: "var(--color-brand-instagram)", path: PATHS.instagram },
  { name: "TikTok", line: "Little clips from the road", href: link("TikTok"), color: "var(--color-brand-tiktok)", tint: "var(--color-brand-tiktok-tint)", path: PATHS.tiktok },
];
const site = link("Adam and Linds");
---

<section class="container-page py-16 md:py-20" aria-labelledby="family-title" data-slot="meet-family">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
    <figure class="mx-auto w-full max-w-[36rem] -rotate-[1.5deg] rounded-md bg-white p-2 shadow-[0_10px_30px_-8px_rgb(0_0_0/0.35)]">
      <Image
        quality={70}
        src={familyPhoto}
        alt="The five of us around a restaurant table on Dotonbori in Osaka at night."
        widths={[480, 800, 1000]}
        sizes="(min-width: 1024px) 36rem, 92vw"
        class="aspect-[4/3] w-full rounded-[3px] object-cover"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="flex flex-col items-start gap-5">
      <h2 id="family-title" class="font-display text-display-sm md:text-display-md text-foreground">Meet the family</h2>
      <p class="text-muted-foreground max-w-[34rem] text-lg leading-relaxed md:text-xl">
        We&rsquo;re Adam and Lindsay. Since May 2022, we&rsquo;ve been exploring the world with Lily, Cora, and Harper. Japan keeps drawing us back.
      </p>
      <Button href={routes.about} variant="primary" size="lg">
        Read our story
        <Icon name="arrow-right" size={18} />
      </Button>
    </div>
  </div>

  <div class="mt-16 md:mt-20">
    <div class="pr-40 sm:pr-64 lg:pr-72">
      <h2 class="font-display text-display-sm text-foreground">Come along for the trip.</h2>
      <p class="text-muted-foreground mt-2 text-lg">More Japan, more family adventures.</p>
    </div>
    {/* Niko peeks over the card: her body sits behind it (z-0), and a copy
        clipped to just her left paw sits in front (z-20), so the paw rests on
        the card's top edge. */}
    <div class="relative mt-6">
      <div class="niko-peek pointer-events-none absolute right-2 bottom-[calc(100%-9px)] w-36 sm:right-10 sm:bottom-[calc(100%-11px)] sm:w-48 lg:bottom-[calc(100%-13px)] lg:w-56" aria-hidden="true">
        <img src="/brand/niko/niko-wave-peek.webp" alt="" width="480" height="403" loading="lazy" decoding="async" class="relative z-0 block w-full" />
        <img src="/brand/niko/niko-wave-peek.webp" alt="" width="480" height="403" loading="lazy" decoding="async" class="niko-paw absolute inset-0 z-20 block w-full" />
      </div>
    <ul class="bg-card border-border rounded-card relative z-10 grid divide-y divide-[var(--color-border)] border md:grid-cols-3 md:divide-x md:divide-y-0">
      {
        channels.map((c) => (
          <li>
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer me"
              class="group hover:bg-muted/50 flex items-center gap-4 p-5 transition-colors duration-150 md:p-6"
            >
              <span class="grid size-14 shrink-0 place-items-center rounded-xl" style={`background: color-mix(in srgb, ${c.tint} 12%, transparent)`} aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" fill={c.color}><path d={c.path} /></svg>
              </span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="font-display text-foreground text-lg font-semibold">{c.name}</span>
                <span class="text-muted-foreground text-sm">{c.line}</span>
              </span>
              <span class="text-foreground transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none" aria-hidden="true">
                <Icon name="arrow-up-right" size={20} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    </div>
    <a
      href={site}
      target="_blank"
      rel="noopener noreferrer me"
      class="text-foreground mt-6 inline-flex min-h-11 items-center gap-2 font-medium underline underline-offset-4"
    >
      <Icon name="globe" size={20} />
      Visit Adam and Linds
      <Icon name="arrow-up-right" size={16} />
    </a>
  </div>
</section>

<style>
  /* Only Niko's left paw, drawn over the card. */
  .niko-paw {
    clip-path: polygon(0% 76%, 24% 76%, 24% 100%, 0% 100%);
  }
</style>
