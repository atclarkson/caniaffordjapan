---
// src/components/Sections/Home/LatestPosts.astro - la grille des notes recentes de l'accueil, avec sa sortie vers l'archive complete.
import PostCard from "@components/Cards/PostCard.astro";
import SectionHeader from "@components/Sections/Global/SectionHeader.astro";
import { Icon } from "@components/svg/icons";
import { getSiteRoutes } from "@config/navData.json.ts";
import { fmt, getLocale, useTranslations } from "@i18n";
import type { ResolvedPost } from "@js/posts";

type Props = {
  /** Les billets deja tries et coupes par la page : la section ne trie pas. */
  posts: ResolvedPost[];
  /** Total published posts, for the "View all" link. */
  total: number;
};

const { posts, total } = Astro.props;
const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);
---

<section class="bg-surface border-border border-y" aria-labelledby="latest-title" data-slot="latest-posts">
  <div class="container-page py-16 md:py-20">
    <SectionHeader
      as="h2"
      headingId="latest-title"
      title={t.home.latestTitle}
      accentWord={t.home.latestAccent}
      lede={t.home.latestLede}
    />

    <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((entry) => (
          <li class="flex">
            <PostCard {entry} {locale} as="h3" class="w-full" />
          </li>
        ))
      }
    </ul>
    <a
      href={routes.posts}
      class="text-primary mt-8 inline-flex min-h-11 items-center gap-1.5 font-semibold underline-offset-4 hover:underline"
    >
      {fmt(t.home.latestCta, { n: total })}
      <Icon name="arrow-right" size={16} />
    </a>
  </div>
</section>
