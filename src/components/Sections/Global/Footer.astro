---
// src/components/Sections/Global/Footer.astro - the site footer: logo and one line, one row of links, the family's real profiles, copyright.
//
// Simplified 2026-11-12 (the owner asked for a cleaner footer): no
// all-caps column headings, no dormant newsletter form, no theme demo
// notice. Everything here is real: the links are the site's own pages, the
// profiles come from the author file, and "Privacy and terms" is the one
// legal page (/legal/).
import { Icon } from "@components/svg/icons";
import { getSiteRoutes } from "@config/navData.json.ts";
import siteData from "@config/siteData.json";
import author from "@data/authors/en/the-clarksons.json";
import { getLocale, useTranslations } from "@i18n";

const locale = getLocale(Astro);
const t = useTranslations(locale);
const routes = getSiteRoutes(locale);
const year = new Date().getFullYear();

const pages = [
  { text: t.nav.posts, href: routes.posts },
  { text: t.nav.topics, href: routes.topics },
  { text: t.nav.about, href: routes.about },
  { text: t.nav.contact, href: routes.contact },
  { text: t.footer.imprint, href: routes.imprint },
  { text: t.footer.rss, href: routes.rss },
];

const link =
  "text-muted-foreground hover:text-foreground inline-flex min-h-11 items-center text-[0.95rem] transition-colors duration-150";
---

<footer class="bg-surface border-border border-t" data-slot="footer">
  <div class="container-page py-14 md:py-16">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="flex max-w-[26rem] flex-col gap-4">
        <a href={routes.home} class="inline-flex min-h-11 items-center self-start" aria-label={t.nav.brandHome}>
          <img src="/brand/logos/footer-logo.webp" alt="" width="720" height="275" class="h-14 w-auto dark:hidden" decoding="async" />
          <img src="/brand/logos/footer-logo-dark.webp" alt="" width="720" height="275" class="hidden h-14 w-auto dark:block" decoding="async" />
          <span class="sr-only">{siteData.name}</span>
        </a>
        <p class="text-muted-foreground text-[0.95rem] leading-relaxed">{t.footer.tagline}</p>
      </div>

      <div class="flex flex-col gap-6 lg:items-end">
        <nav aria-label={t.footer.colRead}>
          <ul class="flex flex-wrap gap-x-6 gap-y-1">
            {
              pages.map((page) => (
                <li>
                  <a href={page.href} class={link}>
                    {page.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ul class="flex flex-wrap gap-2.5">
          {
            author.links.map((profile) => (
              <li>
                <a
                  href={profile.href}
                  target="_blank"
                  rel="noopener noreferrer me"
                  class="rounded-pill border-border bg-card text-foreground hover:border-foreground/40 inline-flex min-h-10 items-center gap-1.5 border px-3.5 text-sm font-medium transition-colors duration-150"
                >
                  {profile.label}
                  <Icon name="arrow-up-right" size={14} />
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${siteData.author.email}`}
              class="rounded-pill border-border bg-card text-foreground hover:border-foreground/40 inline-flex min-h-10 items-center gap-1.5 border px-3.5 text-sm font-medium transition-colors duration-150"
            >
              <Icon name="mail" size={14} />
              {t.footer.emailStudio}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="border-border text-muted-foreground mt-10 border-t pt-6 text-sm">
      &copy; {year} {siteData.name} {t.footer.rights}
    </p>
  </div>
</footer>
