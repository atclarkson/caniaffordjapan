---
// src/components/Post/Receipt.astro - a real day's spending as a paper receipt (torn top/bottom edges).
//
// Pulled out of Home/WhatWeSpent.astro (added 2026-11-12) so the same look
// can drop into a post body, not just the home page. Every number passed in
// must come from the post's own real figures, never invented or rounded
// beyond what the source data actually gives.
//
// Usage in an .mdx post:
//   import Receipt from "@components/Post/Receipt.astro";
//   <Receipt
//     heading="One day in Ueno"
//     subheading="Family of five"
//     total={{ yen: "¥49,295", usd: "$315.49" }}
//     groups={[
//       { label: "Room", items: [{ name: "One night", yen: "¥27,475", usd: "$175.84" }] },
//       { label: "Food", items: [{ name: "Dinner", yen: "¥8,510", usd: "$54.46" }] },
//     ]}
//   />
import { Icon } from "@components/svg/icons";

interface ReceiptItem {
  name: string;
  yen: string;
  usd: string;
}

interface ReceiptGroup {
  label: string;
  items: readonly ReceiptItem[];
}

interface Props {
  heading: string;
  subheading?: string;
  groups: readonly ReceiptGroup[];
  total: { yen: string; usd: string };
  totalLabel?: string;
  /** Only set this on the home page's teaser copy; a post's own receipt is already the full day, no link needed. */
  readMoreHref?: string;
  readMoreLabel?: string;
}

const { heading, subheading, groups, total, totalLabel, readMoreHref, readMoreLabel = "Read the full day" } = Astro.props;
---

<div class="receipt-shadow mx-auto w-full min-w-0 max-w-[34rem] not-prose">
  <div class="receipt bg-white px-4 pt-10 min-[360px]:px-6 pb-12 text-neutral-900 sm:px-9">
    <h3 class="font-display text-center text-xl font-semibold">{heading}</h3>
    {subheading && <p class="mt-1 text-center font-mono text-sm text-neutral-500">{subheading}</p>}

    <div class="receipt-rule mt-6"></div>

    <dl class="mt-4 flex flex-col gap-4">
      {
        groups.map((group) => (
          <div>
            <dt class="font-mono text-sm font-semibold text-neutral-500">{group.label}</dt>
            <dd>
              <ul class="mt-1.5">
                {group.items.map((item) => (
                  <li class="flex items-baseline gap-2 py-1 font-mono text-[0.9rem]">
                    <span class="min-w-0 [overflow-wrap:anywhere]">{item.name}</span>
                    <span class="mx-1 flex-1 translate-y-[-3px] border-b border-dotted border-neutral-300" aria-hidden="true" />
                    <span class="tabular-nums">{item.yen}</span>
                    <span class="w-[4.5rem] shrink-0 text-right text-neutral-500 tabular-nums">{item.usd}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="receipt-rule mt-5"></div>

    <p class="mt-4 flex items-baseline justify-between gap-4 font-mono font-bold">
      <span>Total</span>
      <span class="tabular-nums">{total.yen}</span>
    </p>
    <p class="mt-1 flex items-baseline justify-between gap-4">
      {totalLabel && <span class="text-sm text-neutral-500">{totalLabel}</span>}
      <span class="font-display ml-auto text-4xl font-bold tabular-nums">{total.usd}</span>
    </p>

    {
      readMoreHref && (
        <>
          <div class="receipt-rule mt-5" />
          <p class="mt-5 text-center">
            <a href={readMoreHref} class="text-primary-text inline-flex min-h-11 items-center gap-1.5 font-semibold underline-offset-4 hover:underline">
              {readMoreLabel}
              <Icon name="arrow-right" size={16} />
            </a>
          </p>
        </>
      )
    }
  </div>
</div>

<style>
  /* Paper receipt: zigzag "torn" edges top and bottom via a mask; the shadow
   * sits on a wrapper because a mask would clip a shadow on the same box. */
  .receipt-shadow {
    filter: drop-shadow(0 10px 18px rgb(0 0 0 / 0.14)) drop-shadow(0 1px 2px rgb(0 0 0 / 0.08));
    rotate: 1deg;
  }
  .receipt {
    --tooth: 9px;
    mask:
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / calc(var(--tooth) * 2) 51% repeat-x,
      conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) top / calc(var(--tooth) * 2) 51% repeat-x;
  }
  .receipt-rule {
    border-top: 2px dashed rgb(0 0 0 / 0.18);
  }
</style>
