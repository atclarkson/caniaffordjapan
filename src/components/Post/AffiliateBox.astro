---
// src/components/Post/AffiliateBox.astro - booking callout dropped into a post body (MDX only).
// Built from the theme's own Card + Button primitives so it matches the rest
// of the site instead of introducing a one-off style. See src/data/affiliates.ts
// and CLAUDE.md "Affiliate links".
import { Card, CardContent, CardHeader, CardTitle } from "@components/ui/card";
import { Button } from "@components/ui/button";
import { Icon } from "@components/svg/icons";
import { affiliates, type Provider } from "@data/affiliates";

interface Props {
  heading: string;
  query: string;
  providers?: Provider[];
  /** Post-specific override, e.g. a real Expedia deep link generated for
   * this exact search rather than the generic account storefront fallback. */
  overrides?: Partial<Record<Provider, string>>;
}

const {
  heading,
  query,
  providers = ["klook", "getyourguide", "expedia"],
  overrides = {},
} = Astro.props;
---

<Card class="my-8 not-prose">
  <CardHeader>
    <CardTitle as="h3" class="text-lg">{heading}</CardTitle>
  </CardHeader>
  <CardContent>
    <p class="text-muted-foreground mb-4 text-sm">
      These are affiliate links. We may earn a commission if you book through them, at no extra
      cost to you. See our <a href="/legal/" class="underline">legal notice</a>.
    </p>
    <div class="flex flex-wrap gap-2">
      {
        providers.map((p) => (
          <Button
            href={overrides[p] ?? affiliates[p].searchUrl(query)}
            target="_blank"
            rel="noopener noreferrer sponsored"
            variant="primary"
            size="sm"
          >
            <Icon name="link" size={15} />
            Search on {affiliates[p].label}
          </Button>
        ))
      }
    </div>
  </CardContent>
</Card>
